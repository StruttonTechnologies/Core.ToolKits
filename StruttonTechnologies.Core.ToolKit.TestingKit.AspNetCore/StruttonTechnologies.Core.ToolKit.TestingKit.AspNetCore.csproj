<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>StruttonTechnologies.Core.ToolKit.TestingKit.AspNetCore</PackageId>
    <Title>StruttonTechnologies Core ToolKit TestingKit AspNetCore</Title>
    <Description>ASP.NET Core test helpers such as HTTP context factories.</Description>
    <PackageTags>testing,toolkit,aspnetcore,httpcontext,strutton,StruttonTechnologies</PackageTags>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
    <RepositoryUrl>https://github.com/StruttonTechnologies/StruttonTechnologies.Core.ToolKit.TestingKit.AspNetCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Authors>Strutton Technologies</Authors>
    <Company>Strutton Technologies</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Http" />
  </ItemGroup>

</Project>
