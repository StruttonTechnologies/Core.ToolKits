<Project Sdk="Microsoft.NET.Sdk">

  <!-- Package identity -->
  <PropertyGroup>
    <PackageId>StruttonTechnologies.Core.ToolKit.Validation</PackageId>
    <Title>StruttonTechnologies Core ToolKit Validation</Title>
    <Description>Core validation framework and reusable validators for StruttonTechnologies applications. Concept-specific validators delegate universal truth checks to StruttonTechnologies.Core.Rules.</Description>
    <PackageTags>validation,toolkit,core,validators,fluent,strutton,StruttonTechnologies</PackageTags>

    <!-- Versioning -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>

    <!-- Packaging -->
    <IsPackable>true</IsPackable>

  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="StruttonTechnologies.Core.Rules" />
  </ItemGroup>

</Project>