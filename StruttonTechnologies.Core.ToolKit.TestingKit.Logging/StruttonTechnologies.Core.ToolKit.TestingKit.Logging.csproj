<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>StruttonTechnologies.Core.ToolKit.TestingKit.Logging</PackageId>
    <Title>StruttonTechnologies Core ToolKit TestingKit Logging</Title>
    <Description>Moq-based logging verification helpers for ILogger tests.</Description>
    <PackageTags>testing,toolkit,logging,ilogger,moq,strutton,StruttonTechnologies</PackageTags>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
    <RepositoryUrl>https://github.com/StruttonTechnologies/StruttonTechnologies.Core.ToolKit.TestingKit.Logging</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Authors>Strutton Technologies</Authors>
    <Company>Strutton Technologies</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Moq" />
  </ItemGroup>

</Project>
