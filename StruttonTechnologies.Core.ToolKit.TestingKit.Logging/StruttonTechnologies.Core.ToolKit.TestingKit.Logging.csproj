<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>StruttonTechnologies.Core.ToolKit.TestingKit.Logging</PackageId>
    <Title>StruttonTechnologies Core ToolKit TestingKit Logging</Title>
    <Description>Moq-based logging verification helpers for ILogger tests.</Description>
    <PackageTags>testing,toolkit,logging,ilogger,moq,strutton,StruttonTechnologies</PackageTags>

    <!-- Versioning -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>

    <!-- Packaging -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Moq" />
  </ItemGroup>

</Project>
